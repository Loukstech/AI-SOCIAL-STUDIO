{
  "name": "ai-social-studio",
  "private": true,
  "version": "0.0.0",
  "description": "AI Social Studio — studio de production et de distribution de contenus assisté par IA",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:online": "node scripts/smoke-online.mjs",
    "test:phase1": "node scripts/smoke-phase1.mjs",
    "test:phase2": "node scripts/smoke-phase2.mjs",
    "test:phase3": "node scripts/smoke-phase3.mjs",
    "test:phase4": "node scripts/smoke-phase4.mjs",
    "test:phase5": "node scripts/smoke-phase5.mjs",
    "test:phase6": "node scripts/smoke-phase6.mjs",
    "test:phase7": "node scripts/smoke-phase7.mjs",
    "test:phase8": "node scripts/smoke-phase8.mjs",
    "verify:png": "node scripts/verify-png-export.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @ass/database generate",
    "db:migrate": "pnpm --filter @ass/database migrate:dev",
    "db:deploy": "pnpm --filter @ass/database migrate:deploy",
    "test:phase9": "node scripts/smoke-phase9.mjs",
    "test:phase10": "node scripts/smoke-phase10.mjs",
    "test:phase11": "node scripts/smoke-phase11.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "turbo": "^2.11.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
