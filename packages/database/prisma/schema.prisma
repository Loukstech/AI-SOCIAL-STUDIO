// Schéma Prisma d'AI Social Studio — Phases 1 et 2.
// Règles appliquées : identifiants UUID, soft-delete via `deletedAt`,
// isolation multi-tenant par `organizationId`, journal d'audit append-only,
// jetons OAuth chiffrés (AES-256-GCM) et invitations stockées par empreinte.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum MediaKind {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

enum SocialPlatform {
  INSTAGRAM
  FACEBOOK
  TIKTOK
  LINKEDIN
  YOUTUBE
  X
  PINTEREST
  THREADS
}

enum SocialAccountStatus {
  CONNECTED
  EXPIRED
  REVOKED
  ERROR
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  memberships  Member[]
  sessions     Session[]
  auditLogs    AuditLog[]
  invitations  Invitation[]

  @@index([deletedAt])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Organization {
  id        String       @id @default(uuid())
  name      String
  slug      String       @unique
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?
  members        Member[]
  brands         Brand[]
  media          MediaAsset[]
  auditLogs      AuditLog[]
  socialAccounts SocialAccount[]
  invitations    Invitation[]

  @@index([deletedAt])
}

model Member {
  id             String           @id @default(uuid())
  userId         String
  organizationId String
  role           OrganizationRole @default(VIEWER)
  createdAt      DateTime         @default(now())
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Brand {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  description    String?
  primaryColor   String?
  toneOfVoice    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  media          MediaAsset[]
  socialAccounts SocialAccount[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model MediaAsset {
  id             String       @id @default(uuid())
  organizationId String
  brandId        String?
  name           String
  kind           MediaKind    @default(IMAGE)
  mimeType       String?
  sizeBytes      Int?
  sourceUrl      String?
  createdAt      DateTime     @default(now())
  deletedAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand          Brand?       @relation(fields: [brandId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([brandId])
}

model AuditLog {
  id             String        @id @default(uuid())
  organizationId String?
  actorId        String?
  action         String
  targetType     String?
  targetId       String?
  metadata       Json?
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor          User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorId])
}

/// Compte social rattaché à une organisation (et éventuellement à une marque).
/// Les jetons OAuth sont stockés chiffrés en AES-256-GCM : jamais en clair.
model SocialAccount {
  id             String              @id @default(uuid())
  organizationId String
  brandId        String?
  platform       SocialPlatform
  username       String
  displayName    String?
  avatarUrl      String?
  externalId     String?
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?
  scopes         String[]            @default([])
  status         SocialAccountStatus @default(CONNECTED)
  lastSyncedAt   DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  deletedAt      DateTime?
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand          Brand?              @relation(fields: [brandId], references: [id], onDelete: SetNull)

  @@unique([organizationId, platform, username])
  @@index([organizationId])
  @@index([brandId])
  @@index([deletedAt])
}

/// Invitation à rejoindre une organisation. Seule l'empreinte SHA-256 du jeton
/// est stockée : le lien complet n'existe qu'entre les mains de l'invité.
model Invitation {
  id             String           @id @default(uuid())
  organizationId String
  email          String
  role           OrganizationRole @default(VIEWER)
  tokenHash      String           @unique
  invitedById    String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      User?            @relation(fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([organizationId, email])
  @@index([expiresAt])
}
