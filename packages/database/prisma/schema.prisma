// Schéma Prisma d'AI Social Studio — Phases 1 et 2.
// Règles appliquées : identifiants UUID, soft-delete via `deletedAt`,
// isolation multi-tenant par `organizationId`, journal d'audit append-only,
// jetons OAuth chiffrés (AES-256-GCM) et invitations stockées par empreinte.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// `CLIENT` (§14) : lit son espace, commente et valide, sans rien modifier.
enum OrganizationRole {
  OWNER
  ADMIN
  EDITOR
  CLIENT
  VIEWER
}

enum MediaKind {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

enum SocialPlatform {
  INSTAGRAM
  FACEBOOK
  TIKTOK
  LINKEDIN
  YOUTUBE
  X
  PINTEREST
  THREADS
}

enum SocialAccountStatus {
  CONNECTED
  EXPIRED
  REVOKED
  ERROR
}

enum VideoProjectStatus {
  DRAFT
  TRANSCRIBING
  TRANSCRIBED
  FAILED
}

enum TranscriptStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum SubtitleStyle {
  PROFESSIONAL
  MINIMAL
  KARAOKE
  KEYWORDS
  DYNAMIC
  CREATOR
  PODCAST
}

/// Types de contenus du AI Content Studio (§6.2).
enum ContentType {
  PROMO
  ANNOUNCEMENT
  PROMOTION
  COMPANY_INTRO
  QUOTE
  TIP
  TUTORIAL
  TESTIMONIAL
  PRODUCT_LAUNCH
  EVENT
  SPECIAL_OFFER
  EDUCATIONAL
  VIDEO_SCRIPT
  CAROUSEL
}

enum ContentTone {
  PROFESSIONAL
  DYNAMIC
  FRIENDLY
  EXPERT
  INSPIRING
  PLAYFUL
}

enum ContentLanguage {
  FR
  EN
}

model User {
  id                      String                   @id @default(uuid())
  email                   String                   @unique
  name                    String
  passwordHash            String
  /// Administration de la plateforme (§17), sans rapport avec les rôles d'organisation.
  isSuperAdmin            Boolean                  @default(false)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  deletedAt               DateTime?
  memberships             Member[]
  sessions                Session[]
  auditLogs               AuditLog[]
  invitations             Invitation[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  comments                Comment[]                @relation("CommentAuthor")
  tasksAssigned           Task[]                   @relation("TaskAssignee")
  tasksCreated            Task[]                   @relation("TaskCreator")
  creditTransactions      CreditTransaction[]

  @@index([deletedAt])
  @@index([isSuperAdmin])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Organization {
  id                      String                   @id @default(uuid())
  name                    String
  slug                    String                   @unique
  /// Fuseau de référence pour l'affichage et la programmation (§11).
  /// Les dates restent stockées en UTC ; ce champ ne sert qu'à la conversion.
  timezone                String                   @default("Europe/Paris")
  /// Plan courant (§16.1). Les plans et leurs quotas sont des lignes de `Plan`,
  /// pas des constantes du code.
  planKey                 String                   @default("free")
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  deletedAt               DateTime?
  members                 Member[]
  brands                  Brand[]
  media                   MediaAsset[]
  auditLogs               AuditLog[]
  socialAccounts          SocialAccount[]
  invitations             Invitation[]
  videoProjects           VideoProject[]
  contentProjects         ContentProject[]
  publications            Publication[]
  imageProjects           ImageProject[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  comments                Comment[]
  tasks                   Task[]
  creditAccount           CreditAccount?

  @@index([deletedAt])
  @@index([planKey])
}

model Member {
  id             String           @id @default(uuid())
  userId         String
  organizationId String
  role           OrganizationRole @default(VIEWER)
  createdAt      DateTime         @default(now())
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

/// Marque et son Brand Kit (§8). Les logos sont référencés par identifiant de
/// média : le fichier d'origine n'est jamais modifié ni dupliqué.
model Brand {
  id                    String           @id @default(uuid())
  organizationId        String
  name                  String
  description           String?
  primaryColor          String?
  toneOfVoice           String?
  /// Palette complète, du fond à l'accent. `primaryColor` reste la couleur
  /// d'entrée historique ; `palette` la complète sans la remplacer.
  palette               String[]         @default([])
  logoPrimaryId         String?
  logoSecondaryId       String?
  headingFont           String?
  bodyFont              String?
  slogan                String?
  website               String?
  contactEmail          String?
  contactPhone          String?
  /// [{ platform, url }] — liens des réseaux de la marque.
  socialLinks           Json?
  referenceImageIds     String[]         @default([])
  /// Consignes éditoriales libres, appliquées à la génération.
  editorialInstructions String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  deletedAt             DateTime?
  organization          Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  media                 MediaAsset[]
  socialAccounts        SocialAccount[]
  videoProjects         VideoProject[]
  contentProjects       ContentProject[]
  publications          Publication[]
  imageProjects         ImageProject[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model MediaAsset {
  id             String       @id @default(uuid())
  organizationId String
  brandId        String?
  name           String
  kind           MediaKind    @default(IMAGE)
  mimeType       String?
  sizeBytes      Int?
  sourceUrl      String?
  createdAt      DateTime     @default(now())
  deletedAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand          Brand?       @relation(fields: [brandId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([brandId])
}

model AuditLog {
  id             String        @id @default(uuid())
  organizationId String?
  actorId        String?
  action         String
  targetType     String?
  targetId       String?
  metadata       Json?
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor          User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorId])
}

/// Compte social rattaché à une organisation (et éventuellement à une marque).
/// Les jetons OAuth sont stockés chiffrés en AES-256-GCM : jamais en clair.
model SocialAccount {
  id                 String              @id @default(uuid())
  organizationId     String
  brandId            String?
  platform           SocialPlatform
  username           String
  displayName        String?
  avatarUrl          String?
  externalId         String?
  accessToken        String?
  refreshToken       String?
  tokenExpiresAt     DateTime?
  scopes             String[]            @default([])
  status             SocialAccountStatus @default(CONNECTED)
  lastSyncedAt       DateTime?
  /// Détection d'erreur (§9.3) : dernière panne connue et sa date.
  lastError          String?
  lastErrorAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand              Brand?              @relation(fields: [brandId], references: [id], onDelete: SetNull)
  publicationTargets PublicationTarget[]

  @@unique([organizationId, platform, username])
  @@index([organizationId])
  @@index([brandId])
  @@index([deletedAt])
}

/// Invitation à rejoindre une organisation. Seule l'empreinte SHA-256 du jeton
/// est stockée : le lien complet n'existe qu'entre les mains de l'invité.
model Invitation {
  id             String           @id @default(uuid())
  organizationId String
  email          String
  role           OrganizationRole @default(VIEWER)
  tokenHash      String           @unique
  invitedById    String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      User?            @relation(fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([organizationId, email])
  @@index([expiresAt])
}

/// Projet vidéo : la source, sa transcription et ses pistes de sous-titres.
/// Le rendu ffmpeg arrivera avec un worker dédié et le stockage objet.
model VideoProject {
  id              String             @id @default(uuid())
  organizationId  String
  brandId         String?
  name            String
  description     String?
  sourceUrl       String?
  language        String             @default("fr")
  durationSeconds Int?
  status          VideoProjectStatus @default(DRAFT)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand           Brand?             @relation(fields: [brandId], references: [id], onDelete: SetNull)
  transcript      Transcript?
  subtitles       SubtitleTrack[]
  clips           ClipSuggestion[]

  @@index([organizationId, createdAt])
  @@index([brandId])
  @@index([deletedAt])
}

/// Suggestion de clip (Mode A) : un passage autonome extrait de la transcription,
/// avec un score de pertinence et sa justification. L'utilisateur garde le dernier mot.
model ClipSuggestion {
  id        String       @id @default(uuid())
  projectId String
  title     String
  summary   String
  start     Float
  end       Float
  duration  Float
  score     Int
  rationale String
  selected  Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  project   VideoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, score])
}

model Transcript {
  id        String           @id @default(uuid())
  projectId String           @unique
  status    TranscriptStatus @default(PENDING)
  language  String           @default("fr")
  provider  String?
  text      String?
  segments  Json?
  error     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  project   VideoProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model SubtitleTrack {
  id        String        @id @default(uuid())
  projectId String
  style     SubtitleStyle
  language  String        @default("fr")
  content   String
  cueCount  Int           @default(0)
  /// Cues structurées, source de vérité pour les exports SRT / VTT / TXT.
  cues      Json?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  project   VideoProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, style, language])
  @@index([projectId])
}

/// Brief éditorial saisi par l'utilisateur, et ses déclinaisons par plateforme.
/// Le fournisseur est tracé : `mock` (déterministe) ou un modèle réel en Phase 6.
model ContentProject {
  id             String           @id @default(uuid())
  organizationId String
  brandId        String?
  brief          String
  subject        String?
  objective      String?
  audience       String?
  tone           ContentTone      @default(PROFESSIONAL)
  contentType    ContentType      @default(PROMO)
  language       ContentLanguage  @default(FR)
  provider       String           @default("mock")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand          Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  variants       ContentVariant[]
  publications   Publication[]

  @@index([organizationId, createdAt])
  @@index([deletedAt])
}

/// Variante propre à une plateforme : éditable indépendamment (§6.3).
model ContentVariant {
  id           String          @id @default(uuid())
  projectId    String
  platform     SocialPlatform
  /// Une même plateforme peut porter une version FR et une version EN.
  language     ContentLanguage @default(FR)
  title        String?
  body         String
  hashtags     String[]        @default([])
  callToAction String?
  charCount    Int             @default(0)
  /// Dépassements et écarts aux règles de la plateforme, calculés à la génération.
  warnings     String[]        @default([])
  edited       Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  project      ContentProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, platform, language])
  @@index([projectId])
}

// --- Phase 6 : Publishing Center et Content Calendar (§10, §11) ---

/// Formats de publication (§10.1). Le format doit être supporté par toutes les
/// cibles d'une publication : la validation le vérifie avant l'envoi.
enum PostType {
  TEXT
  IMAGE
  GALLERY
  VIDEO
  REEL
  SHORT
  CAROUSEL
  LINK
}

/// Cycle de vie d'une publication (§10.3).
enum PublicationStatus {
  DRAFT
  READY_FOR_REVIEW
  PENDING_APPROVAL
  APPROVED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  REJECTED
  CANCELLED
  FAILED
  EXPIRED
}

/// `AUTO` publie à l'échéance ; `APPROVAL` exige l'accord d'un responsable (§10.2).
enum PublicationMode {
  AUTO
  APPROVAL
}

/// Sort de chaque cible prise séparément : une publication peut réussir sur un
/// réseau et échouer sur un autre sans perdre l'ensemble.
enum PublicationTargetStatus {
  PENDING
  PUBLISHED
  FAILED
  SKIPPED
}

/// Publication planifiée vers un ou plusieurs comptes sociaux.
model Publication {
  id               String              @id @default(uuid())
  organizationId   String
  brandId          String?
  createdById      String?
  /// Rattachée à un projet du Content Studio quand elle en reprend le texte.
  contentProjectId String?
  title            String?
  postType         PostType            @default(TEXT)
  mode             PublicationMode     @default(AUTO)
  status           PublicationStatus   @default(DRAFT)
  /// Instant d'envoi prévu, stocké en UTC.
  scheduledAt      DateTime?
  publishedAt      DateTime?
  /// Fuseau de l'organisation au moment de la programmation : conserve
  /// l'intention de l'auteur même si le réglage de l'organisation change.
  timezone         String              @default("Europe/Paris")
  attempts         Int                 @default(0)
  lastError        String?
  rejectionReason  String?
  mediaIds         String[]            @default([])
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  deletedAt        DateTime?
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand            Brand?              @relation(fields: [brandId], references: [id], onDelete: SetNull)
  contentProject   ContentProject?     @relation(fields: [contentProjectId], references: [id], onDelete: SetNull)
  targets          PublicationTarget[]
  events           PublicationEvent[]

  @@index([organizationId, status, scheduledAt])
  @@index([organizationId, scheduledAt])
  @@index([deletedAt])
}

/// Une ligne par compte social visé, avec son propre texte (§10.4).
model PublicationTarget {
  id              String                  @id @default(uuid())
  publicationId   String
  socialAccountId String
  platform        SocialPlatform
  body            String
  title           String?
  hashtags        String[]                @default([])
  status          PublicationTargetStatus @default(PENDING)
  externalId      String?
  externalUrl     String?
  error           String?
  publishedAt     DateTime?
  publication     Publication             @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  socialAccount   SocialAccount           @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  metrics         PublicationMetric[]

  @@unique([publicationId, socialAccountId])
  @@index([publicationId])
}

/// Journal des changements d'état : sert l'historique (§10.4) et l'audit.
model PublicationEvent {
  id            String             @id @default(uuid())
  publicationId String
  fromStatus    PublicationStatus?
  toStatus      PublicationStatus
  actorId       String?
  reason        String?
  createdAt     DateTime           @default(now())
  publication   Publication        @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@index([publicationId, createdAt])
}

// --- Phase 10 : Analytics (§13) ---

/// Provenance d'une mesure. §13 impose de l'afficher : une valeur saisie à la
/// main et une valeur lue sur l'API du réseau n'ont pas la même valeur.
enum MetricSource {
  /// Saisie par un utilisateur dans le studio.
  MANUAL
  /// Lue sur l'API du fournisseur par un adaptateur natif.
  PLATFORM_API
  /// Rapportée par le transport de publication externe.
  WEBHOOK
}

/// Une mesure, à une date, pour une cible de publication.
///
/// Chaque colonne est **nullable** : `null` signifie « métrique indisponible
/// pour cette mesure », `0` signifie « mesurée à zéro ». Confondre les deux
/// reviendrait à inventer des chiffres, ce que le cahier des charges interdit.
model PublicationMetric {
  id             String            @id @default(uuid())
  organizationId String
  targetId       String
  platform       SocialPlatform
  source         MetricSource
  /// Date à laquelle les chiffres ont été observés chez le réseau.
  collectedAt    DateTime
  /// Date d'enregistrement dans le studio (peut différer de `collectedAt`).
  syncedAt       DateTime          @default(now())
  recordedById   String?
  views          Int?
  impressions    Int?
  reach          Int?
  likes          Int?
  comments       Int?
  shares         Int?
  saves          Int?
  clicks         Int?
  /// Précision libre : panneau utilisé, période réelle, outil de relevé…
  note           String?
  target         PublicationTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@index([organizationId, collectedAt])
  @@index([targetId, collectedAt])
}

// --- Phase 7 : AI Image Studio et Brand Kit (§7, §8) ---

/// Formats prédéfinis du cahier des charges. `CUSTOM` exige des dimensions
/// explicites, bornées par le service.
enum ImageFormat {
  SQUARE
  PORTRAIT_4_5
  STORY_9_16
  LANDSCAPE_16_9
  CUSTOM
}

enum ImageStyle {
  EDITORIAL
  BOLD
  MINIMAL
  GRADIENT
}

/// Visuel généré. La source SVG est stockée telle quelle : elle est
/// reproductible, ses textes restent modifiables, et elle ne dépend d'aucun
/// service externe. Le logo référencé n'est jamais copié ni altéré.
model ImageProject {
  id                String          @id @default(uuid())
  organizationId    String
  brandId           String?
  createdById       String?
  title             String?
  /// Consignes de composition saisies par l'utilisateur.
  prompt            String
  format            ImageFormat     @default(SQUARE)
  width             Int
  height            Int
  style             ImageStyle      @default(EDITORIAL)
  /// Traçabilité de la génération (§7) : moteur, version, graine.
  provider          String          @default("svg")
  model             String          @default("layout-v1")
  seed              Int
  /// Réseau visé : sert à refuser un format incompatible (§8).
  platform          SocialPlatform?
  /// Instantané de la palette réellement appliquée.
  palette           String[]        @default([])
  logoMediaId       String?
  referenceMediaIds String[]        @default([])
  /// Couches de texte, corrigeables indépendamment.
  headline          String?
  subheadline       String?
  callToAction      String?
  badge             String?
  svg               String
  /// Débordements et écarts détectés au rendu.
  warnings          String[]        @default([])
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?
  /// Visuel d'origine quand celui-ci est une déclinaison (§7).
  sourceProjectId   String?
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand             Brand?          @relation(fields: [brandId], references: [id], onDelete: SetNull)
  source            ImageProject?   @relation("ImageVariants", fields: [sourceProjectId], references: [id], onDelete: SetNull)
  variants          ImageProject[]  @relation("ImageVariants")

  @@index([organizationId, createdAt])
  @@index([brandId])
  @@index([deletedAt])
  @@index([sourceProjectId])
}

// --- Phase 11 : Notifications (§15) ---

/// Événements que le cahier des charges demande de notifier (§15).
///
/// Les dix types existent dans le contrat, mais tous ne sont pas encore
/// émis : un type dont le sous-système n'existe pas (rendu vidéo, facturation)
/// est déclaré **non branché avec son motif** par `GET /notifications/catalog`,
/// plutôt que de produire une notification creuse.
enum NotificationType {
  PUBLICATION_PUBLISHED
  PUBLICATION_FAILED
  APPROVAL_REQUESTED
  CONTENT_APPROVED
  CONTENT_REJECTED
  VIDEO_READY
  EXPORT_READY
  SOCIAL_CONNECTION_EXPIRED
  CREDITS_LOW
  PAYMENT_FAILED
}

/// Canaux d'un abonnement. L'e-mail est enregistré même sans transport : la
/// préférence survit au branchement d'un fournisseur.
enum NotificationChannel {
  IN_APP
  EMAIL
}

/// Sort réservé au canal e-mail, conservé pour chaque notification.
///
/// `NO_PROVIDER` n'est pas un échec technique : c'est l'aveu qu'aucun transport
/// n'est configuré. Il est distinct de `FAILED`, qui suppose un envoi tenté.
enum NotificationEmailStatus {
  NOT_REQUESTED
  NO_PROVIDER
  SENT
  FAILED
}

/// Notification interne destinée à un utilisateur d'une organisation.
model Notification {
  id             String                  @id @default(uuid())
  organizationId String
  userId         String
  type           NotificationType
  title          String
  body           String
  /// Entité concernée, pour ouvrir le bon écran depuis la notification.
  entityType     String?
  entityId       String?
  url            String?
  /// Clé de déduplication : deux appels portant la même clé se cumulent au
  /// lieu de créer deux lignes.
  dedupeKey      String?
  /// Nombre d'occurrences agrégées sous cette clé.
  occurrences    Int                     @default(1)
  /// Faux quand l'utilisateur a coupé le canal interne pour ce type : la ligne
  /// reste (c'est le journal de l'envoi e-mail) mais n'entre pas dans la boîte.
  inApp          Boolean                 @default(true)
  readAt         DateTime?
  createdAt      DateTime                @default(now())
  lastOccurredAt DateTime                @default(now())
  emailStatus    NotificationEmailStatus @default(NOT_REQUESTED)
  /// Motif exact quand l'e-mail n'est pas parti (transport absent, erreur…).
  emailError     String?
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, dedupeKey])
  @@index([userId, organizationId, readAt])
  @@index([organizationId, createdAt])
}

/// Préférences par utilisateur et par type d'événement (§15).
///
/// Une ligne absente signifie « valeur par défaut » : interne activé,
/// e-mail désactivé. On n'écrit donc que ce que l'utilisateur change.
model NotificationPreference {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  type           NotificationType
  inApp          Boolean          @default(true)
  email          Boolean          @default(false)
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, type])
  @@index([userId, organizationId])
}

// --- Phase 12 : Collaboration (§14) ---

/// Portée d'un commentaire.
///
/// `INTERNAL` reste dans l'agence ; `CLIENT` est visible dans l'espace client.
/// Le filtre est appliqué côté API : un client ne reçoit jamais une ligne
/// interne, même s'il a le droit de commenter.
enum CommentVisibility {
  INTERNAL
  CLIENT
}

enum TaskStatus {
  OPEN
  DONE
  CANCELLED
}

/// Commentaire rattaché à un contenu (publication, projet de contenu, visuel).
///
/// Les réponses ne s'imbriquent que sur un niveau : `parentId` pointe toujours
/// une racine. Supprimer une racine supprime ses réponses (cascade).
model Comment {
  id             String            @id @default(uuid())
  organizationId String
  entityType     String
  entityId       String
  authorId       String
  body           String
  visibility     CommentVisibility @default(INTERNAL)
  parentId       String?
  resolvedAt     DateTime?
  resolvedById   String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author         User              @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parent         Comment?          @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies        Comment[]         @relation("CommentThread")

  @@index([organizationId, entityType, entityId, createdAt])
  @@index([parentId])
  @@index([deletedAt])
}

/// Tâche assignée à un membre, éventuellement rattachée à un contenu.
model Task {
  id             String       @id @default(uuid())
  organizationId String
  entityType     String?
  entityId       String?
  title          String
  description    String?
  status         TaskStatus   @default(OPEN)
  assigneeId     String?
  createdById    String?
  dueAt          DateTime?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignee       User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy      User?        @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, status, dueAt])
  @@index([organizationId, assigneeId, status])
  @@index([entityType, entityId])
}

/// Plans configurables (§16.1) : prix, quotas et fonctionnalités vivent ici,
/// jamais dans le code. `monthlyCredits: null` signifie un plan sans plafond.
model Plan {
  id             String          @id @default(uuid())
  key            String          @unique
  name           String
  monthlyCredits Int?
  /// Fonctionnalités et limites non créditées (ex. nombre de marques).
  limits         Json?
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  accounts       CreditAccount[]
}

enum CreditTransactionType {
  GRANT
  RESERVE
  CONFIRM
  REFUND
  ADJUST
}

/// Solde disponible et réservé d'une organisation. Une seule ligne par org.
model CreditAccount {
  id             String              @id @default(uuid())
  organizationId String              @unique
  planKey        String
  balance        Int                 @default(0)
  reserved       Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan           Plan                @relation(fields: [planKey], references: [key], onUpdate: Cascade)
  transactions   CreditTransaction[]

  @@index([planKey])
}

/// Journal immuable : une ligne par mouvement, identifiée par une clé
/// d'idempotence unique pour empêcher les doubles débits (§16.2).
model CreditTransaction {
  id             String                @id @default(uuid())
  accountId      String
  type           CreditTransactionType
  amount         Int
  idempotencyKey String
  label          String?
  actorId        String?
  createdAt      DateTime              @default(now())
  /**
   * Date de règlement d'une réservation : CONFIRM et REFUND s'excluent.
   */
  settledAt      DateTime?
  account        CreditAccount         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  actor          User?                 @relation(fields: [actorId], references: [id], onDelete: SetNull)

  // Une clé fournie par un client n'est unique que dans SON compte : sans
  // cela, deux organisations choisissant la même clé partagent une écriture.
  @@unique([accountId, idempotencyKey])
  @@index([accountId, createdAt])
}
