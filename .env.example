# Copier ce fichier vers `.env` à la racine, puis renseigner les valeurs.
# Ne jamais committer le fichier `.env` réel.

NODE_ENV=development

# --- API ---
API_PORT=3000
# PORT est injecté par les hébergeurs (Render, Koyeb…) et prend le pas sur API_PORT.
# PORT=
# Origines autorisées par CORS (séparées par des virgules)
CORS_ORIGINS=http://localhost:5173

# --- PostgreSQL ---
# Sans VPS ni Docker : créer une base gratuite sur https://neon.tech et coller l'URL ici.
# Avec Docker (optionnel) : postgresql://ass:ass@localhost:5432/ai_social_studio
DATABASE_URL=

# --- Redis (files BullMQ, cache) ---
# Sans VPS ni Docker : créer une base gratuite sur https://upstash.com (URL en rediss://).
# Avec Docker (optionnel) : redis://localhost:6379
REDIS_URL=

# --- Web ---
VITE_API_URL=http://localhost:3000
# URL publique du frontend, utilisee pour construire les liens d'invitation.
WEB_APP_URL=http://localhost:5173
# Secret de signature des jetons (obligatoire en production, >= 16 car.).
# Generer avec : openssl rand -base64 48
AUTH_SECRET=
# Duree de validite des invitations (heures).
INVITATION_TTL_HOURS=168

# --- IA ---
# mock = transcription de demonstration deterministe (aucun appel externe).
# openai = prevu, necessite OPENAI_API_KEY et l'implementation du fournisseur.
AI_PROVIDER=mock
OPENAI_API_KEY=
